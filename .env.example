# Copy to .env to override any default. Relative paths are resolved from the project root.

# Data
RAW_DATA_PATH=data/tires_sample_10k_sku.csv
PROCESSED_DATA_PATH=data/processed/tires.parquet

# OpenRouter API key for LLMs and EMBEDDING_PROVIDER=openrouter. You can get one at https://openrouter.ai
OPENROUTER_API_KEY=

# Vector store: a local folder by default. Set QDRANT_URL to use a Qdrant server or Qdrant Cloud instead.
QDRANT_PATH=data/vectorstore
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tires

# Dense embeddings: 'fastembed' runs the model locally on CPU, 'openrouter' calls the OpenRouter API
# (e.g. EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free). API vectors are cached in EMBEDDING_CACHE_PATH.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_PATH=.cache/embeddings.sqlite
# Requests sent at once when indexing with a paid OpenRouter model; ':free' models always send one at a time.
EMBEDDING_CONCURRENCY=8

# Sparse (BM25 keyword) embeddings always run locally
SPARSE_MODEL=Qdrant/bm25
MODEL_CACHE_DIR=.cache/fastembed

# Chat model: any OpenRouter model id. Leave a parameter empty to use the provider's default.
# Only set parameters the model supports (listed on its OpenRouter page); tool calling is required.
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_MAX_TOKENS=
LLM_SEED=
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=
# Reasoning effort, e.g. low, medium or high
LLM_REASONING_EFFORT=
# Any other request parameter as a JSON object, e.g. {"top_k": 40, "stop": ["###"]}
LLM_EXTRA_PARAMS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=2
LLM_STREAMING=true
SYSTEM_PROMPT_PATH=prompts/system.md

# Agent limits (positive integers). The model sees the latest AGENT_HISTORY_MESSAGES chat messages
# (the shopper's messages and the answers, cut at the start of a turn; the current turn is always
# sent in full). The saved conversation keeps everything.
AGENT_HISTORY_MESSAGES=10
# Tool calls per shopper message; after that the model answers with the results it has
AGENT_MAX_TOOL_CALLS=5
# Products returned by each catalog search
AGENT_MAX_SEARCH_RESULTS=20

# Guardrail: TypeSafe's Jev (an OpenRouter Decisions model) checks each shopper message before the chat
# model sees it, when the request has it on (the chat page's Guardrail switch). Messages with a block
# score at or above the threshold get a fixed reply and never reach the chat model. If Jev fails or
# takes longer than the timeout, the message goes through. scripts/benchmark_guardrail.py measures it.
GUARDRAIL_MODEL=typesafe/jev-1.13
GUARDRAIL_THRESHOLD=0.7
GUARDRAIL_TIMEOUT_SECONDS=3

# API server (local demo, no auth). Conversation history is stored in CONVERSATIONS_DB_PATH.
# With Docker, API_PORT is the port opened on this machine (the container ignores API_HOST).
API_HOST=127.0.0.1
API_PORT=8000
CONVERSATIONS_DB_PATH=data/conversations.sqlite

# Langfuse tracing (https://langfuse.com): one trace per chat message, grouped into a session per
# conversation. Leave the keys empty to turn tracing off. Keys: your Langfuse project > Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud; US: https://us.cloud.langfuse.com, or a self-hosted URL (from Docker, host.docker.internal instead of localhost)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps traces from different setups apart, e.g. development or production
LANGFUSE_TRACING_ENVIRONMENT=development
